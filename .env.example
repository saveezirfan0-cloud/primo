# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (extraction + drafting, server-side only)
ANTHROPIC_API_KEY=

# Voyage AI embeddings (optional; app falls back to Postgres full-text search)
VOYAGE_API_KEY=

# Simple password gate for the demo
DEMO_PASSWORD=

# Optional overrides
# SUPABASE_DOCUMENTS_BUCKET=documents   # storage bucket for uploaded proposals
# EXTRACTION_MODEL=claude-sonnet-5      # model used for proposal extraction
